<Window x:Class="CodexTaskMonitor.App.ApprovalWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Codex 权限审批"
        Width="560" Height="400"
        MinWidth="500" MinHeight="360"
        WindowStartupLocation="Manual"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="True"
        Topmost="True"
        Loaded="Window_Loaded">
    <Border Background="{StaticResource DialogBackgroundBrush}"
            BorderBrush="{StaticResource DialogBorderBrush}"
            BorderThickness="1"
            CornerRadius="10">
        <Border.Effect>
            <DropShadowEffect BlurRadius="8" ShadowDepth="2" Opacity="0.45" Color="#000000" />
        </Border.Effect>
        <Grid Margin="22,16,22,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <DockPanel MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Button DockPanel.Dock="Right"
                        Width="32" Height="28" MinWidth="32" Margin="0"
                        Padding="0" Content="×" FontSize="18"
                        Style="{StaticResource DialogButtonStyle}"
                        Click="Deny_Click" />
                <TextBlock VerticalAlignment="Center"
                           Foreground="{StaticResource DialogMutedTextBrush}"
                           FontSize="12" Text="CODEX 权限审批" />
            </DockPanel>

            <TextBlock Grid.Row="1" Margin="0,15,0,0"
                       Foreground="{StaticResource DialogTextBrush}"
                       FontSize="21" FontWeight="SemiBold"
                       Text="Codex 请求执行受限操作" />

            <StackPanel Grid.Row="2" Margin="0,12,0,12">
                <TextBlock Text="{Binding Summary}" Foreground="{StaticResource DialogTextBrush}"
                           FontSize="14" TextWrapping="Wrap" />
                <TextBlock Margin="0,7,0,0" Foreground="{StaticResource DialogMutedTextBrush}"
                           Text="{Binding Context}" TextWrapping="Wrap" />
            </StackPanel>

            <Border Grid.Row="3" Background="{StaticResource DialogSurfaceBrush}"
                    BorderBrush="{StaticResource DialogBorderBrush}" BorderThickness="1"
                    CornerRadius="6" Padding="12">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                    <TextBox Text="{Binding Details, Mode=OneWay}"
                             Foreground="{StaticResource DialogTextBrush}"
                             CaretBrush="{StaticResource DialogTextBrush}"
                             FontFamily="Consolas" FontSize="13"
                             IsReadOnly="True" BorderThickness="0"
                             Background="Transparent" TextWrapping="Wrap" />
                </ScrollViewer>
            </Border>

            <DockPanel Grid.Row="4" Margin="0,18,0,0">
                <TextBlock VerticalAlignment="Center"
                           Foreground="{StaticResource DialogMutedTextBrush}"
                           Text="关闭窗口视为拒绝" />
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="拒绝" IsCancel="True" Click="Deny_Click"
                            Style="{StaticResource DialogDangerButtonStyle}" />
                    <Button Content="允许" IsDefault="True" Click="Allow_Click"
                            Style="{StaticResource DialogPrimaryButtonStyle}" />
                </StackPanel>
            </DockPanel>
        </Grid>
    </Border>
</Window>
