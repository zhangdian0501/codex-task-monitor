<Window x:Class="CodexTaskMonitor.App.PromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Codex 任务监视器"
        Width="430"
        SizeToContent="Height"
        MaxHeight="560"
        WindowStartupLocation="Manual"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="True"
        Topmost="True"
        Loaded="Window_Loaded">
    <Border Background="{StaticResource DialogBackgroundBrush}"
            BorderBrush="{StaticResource DialogBorderBrush}"
            BorderThickness="1"
            CornerRadius="10">
        <Border.Effect>
            <DropShadowEffect BlurRadius="8" ShadowDepth="2" Opacity="0.45" Color="#000000" />
        </Border.Effect>
        <Grid Margin="20,15,20,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <DockPanel MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Button DockPanel.Dock="Right"
                        Width="32" Height="28" MinWidth="32" Margin="0"
                        Padding="0" Content="×" FontSize="18"
                        Style="{StaticResource DialogButtonStyle}"
                        Click="Close_Click" />
                <TextBlock VerticalAlignment="Center"
                           Foreground="{StaticResource DialogMutedTextBrush}"
                           FontSize="12" Text="CODEX 任务监视器" />
            </DockPanel>

            <Border x:Name="KindBadge" Grid.Row="1" Margin="0,15,0,0"
                    HorizontalAlignment="Left" Background="#263A5F"
                    CornerRadius="10" Padding="10,4">
                <TextBlock x:Name="KindText" Foreground="#BFDBFE" FontSize="12" />
            </Border>

            <StackPanel Grid.Row="2" Margin="0,12,0,0">
                <TextBlock x:Name="HeadingText" Foreground="{StaticResource DialogTextBrush}"
                           FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap" />
                <TextBlock x:Name="MessageText" Margin="0,9,0,0"
                           Foreground="{StaticResource DialogMutedTextBrush}"
                           FontSize="14" LineHeight="21" TextWrapping="Wrap" />
            </StackPanel>

            <Border x:Name="ContextPanel" Grid.Row="3" Margin="0,16,0,0"
                    Padding="12,10" Background="{StaticResource DialogSurfaceBrush}"
                    BorderBrush="{StaticResource DialogBorderBrush}" BorderThickness="1"
                    CornerRadius="6" Visibility="Collapsed">
                <StackPanel>
                    <TextBlock Foreground="{StaticResource DialogMutedTextBrush}"
                               FontSize="12" FontWeight="SemiBold" Text="助手回复" />
                    <TextBox x:Name="ContextTextBox" Margin="0,8,0,0"
                             MinHeight="96" MaxHeight="240" Padding="0"
                             IsReadOnly="True" AcceptsReturn="True"
                             TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                             Background="Transparent" BorderThickness="0"
                             Foreground="{StaticResource DialogTextBrush}"
                             FontSize="13" />
                </StackPanel>
            </Border>

            <StackPanel x:Name="InputPanel" Grid.Row="4" Margin="0,16,0,0" Visibility="Collapsed">
                <TextBox x:Name="InputTextBox" MinHeight="92" MaxHeight="220"
                         Padding="11,9" AcceptsReturn="True"
                         VerticalScrollBarVisibility="Auto" TextWrapping="Wrap"
                         Background="{StaticResource DialogSurfaceBrush}"
                         BorderBrush="{StaticResource DialogBorderBrush}"
                         Foreground="{StaticResource DialogTextBrush}"
                         CaretBrush="{StaticResource DialogTextBrush}" />
                <TextBlock x:Name="ValidationText" Margin="2,7,0,0"
                           Foreground="#FCA5A5" Text="请输入内容后再提交。"
                           Visibility="Collapsed" />
            </StackPanel>

            <StackPanel Grid.Row="5" Margin="0,20,0,0"
                        Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="SecondaryButton" Content="取消"
                        Style="{StaticResource DialogButtonStyle}"
                        Click="Secondary_Click" />
                <Button x:Name="PrimaryButton" Content="确定" IsDefault="True"
                        Style="{StaticResource DialogPrimaryButtonStyle}"
                        Click="Primary_Click" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
