<Application x:Class="CodexTaskMonitor.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <SolidColorBrush x:Key="AccentBrush" Color="#2563EB" />
        <SolidColorBrush x:Key="DialogBackgroundBrush" Color="#15171C" />
        <SolidColorBrush x:Key="DialogSurfaceBrush" Color="#1E2128" />
        <SolidColorBrush x:Key="DialogBorderBrush" Color="#343843" />
        <SolidColorBrush x:Key="DialogTextBrush" Color="#F4F4F5" />
        <SolidColorBrush x:Key="DialogMutedTextBrush" Color="#A7AAB3" />
        <SolidColorBrush x:Key="DialogDangerBrush" Color="#DC2626" />
        <Style TargetType="Button">
            <Setter Property="Padding" Value="14,7" />
            <Setter Property="Margin" Value="4,0" />
            <Setter Property="MinWidth" Value="84" />
        </Style>
        <Style x:Key="DialogButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="36" />
            <Setter Property="MinWidth" Value="88" />
            <Setter Property="Margin" Value="8,0,0,0" />
            <Setter Property="Padding" Value="16,7" />
            <Setter Property="Background" Value="#292D36" />
            <Setter Property="BorderBrush" Value="#454B58" />
            <Setter Property="Foreground" Value="{StaticResource DialogTextBrush}" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style x:Key="DialogPrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource DialogButtonStyle}">
            <Setter Property="Background" Value="{StaticResource AccentBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
            <Setter Property="Foreground" Value="White" />
        </Style>
        <Style x:Key="DialogDangerButtonStyle" TargetType="Button" BasedOn="{StaticResource DialogButtonStyle}">
            <Setter Property="Background" Value="#7F1D1D" />
            <Setter Property="BorderBrush" Value="{StaticResource DialogDangerBrush}" />
            <Setter Property="Foreground" Value="White" />
        </Style>
    </Application.Resources>
</Application>
