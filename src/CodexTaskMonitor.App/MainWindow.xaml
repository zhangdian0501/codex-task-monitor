<Window x:Class="CodexTaskMonitor.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Codex 任务监视器"
        Width="1000" Height="560"
        MinWidth="760" MinHeight="420"
        WindowStartupLocation="CenterScreen">
    <Grid Background="#FAFAFA">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Background="White" BorderBrush="#E4E4E7" BorderThickness="0,0,0,1" Padding="22,18">
            <DockPanel>
                <StackPanel>
                    <TextBlock FontSize="24" FontWeight="SemiBold" Text="Codex 任务监视器" />
                    <TextBlock Margin="0,5,0,0" Foreground="#666" Text="通过本机 Named Pipe 接收 Codex 生命周期 Hook" />
                </StackPanel>
                <Border DockPanel.Dock="Right" HorizontalAlignment="Right" VerticalAlignment="Center"
                        Background="#EFF6FF" CornerRadius="12" Padding="12,5">
                    <TextBlock Foreground="#1D4ED8" Text="{Binding PipeStatus}" />
                </Border>
            </DockPanel>
        </Border>

        <Grid Grid.Row="1" Margin="22,18">
            <Border Background="White" BorderBrush="#E4E4E7" BorderThickness="1" CornerRadius="6">
                <ListView ItemsSource="{Binding Sessions}" BorderThickness="0" Margin="1">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="状态" Width="130" DisplayMemberBinding="{Binding Status}" />
                            <GridViewColumn Header="会话" Width="210" DisplayMemberBinding="{Binding SessionName}" />
                            <GridViewColumn Header="项目" Width="180" DisplayMemberBinding="{Binding ProjectName}" />
                            <GridViewColumn Header="模型" Width="140" DisplayMemberBinding="{Binding Model}" />
                            <GridViewColumn Header="权限模式" Width="105" DisplayMemberBinding="{Binding PermissionMode}" />
                            <GridViewColumn Header="最近事件" Width="125" DisplayMemberBinding="{Binding LastEvent}" />
                            <GridViewColumn Header="更新时间" Width="80" DisplayMemberBinding="{Binding UpdatedAtText}" />
                        </GridView>
                    </ListView.View>
                </ListView>
            </Border>

            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                        Visibility="{Binding EmptyStateVisibility}">
                <TextBlock FontSize="18" HorizontalAlignment="Center" Foreground="#52525B" Text="暂无 Codex 会话" />
                <TextBlock Margin="0,7,0,0" Foreground="#888" Text="安装并信任 Hooks 后，事件会显示在这里" />
            </StackPanel>
        </Grid>

        <Border Grid.Row="2" Background="White" BorderBrush="#E4E4E7" BorderThickness="0,1,0,0" Padding="22,11">
            <DockPanel>
                <TextBlock Foreground="#666" Text="关闭窗口后程序继续在系统托盘运行" />
                <Button DockPanel.Dock="Right" HorizontalAlignment="Right" Content="清空已结束" Click="ClearEnded_Click" />
            </DockPanel>
        </Border>
    </Grid>
</Window>
